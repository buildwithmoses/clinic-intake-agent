# Copy to .env and fill in. Never commit .env.

# --- Model provider (required) ---
# One key for every model, via OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Only if you switch CLINIC_MODEL to a direct anthropic: model:
# ANTHROPIC_API_KEY=

# --- LangSmith tracing + evals (required for evals, recommended always) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=clinic-intake-agent
# Only if your account is in the EU region:
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# Only if your API key spans multiple workspaces:
# LANGSMITH_WORKSPACE_ID=

# --- Agent config (optional; defaults shown) ---
# Any init_chat_model string works. OpenRouter ids come from openrouter.ai/models,
# e.g. openrouter:anthropic/claude-opus-5.5
# Cheap default. For max quality: openrouter:anthropic/claude-sonnet-5.5
CLINIC_MODEL=openrouter:anthropic/claude-haiku-5.5
# Specialists can run on a different model, e.g. the free openrouter:nvidia/nemotron-3-super-120b-a12b:free (defaults to CLINIC_MODEL)
# CLINIC_SUBAGENT_MODEL=
CLINIC_MAX_MODEL_CALLS_PER_RUN=30
CLINIC_MAX_TOOL_CALLS_PER_RUN=60
CLINIC_MAX_ESCALATIONS_PER_RUN=10
# Mask phone/email/SSN/DOB in LangSmith traces (set false only for synthetic-data debugging)
CLINIC_REDACT_TRACES=true
